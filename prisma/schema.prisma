generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique // usado no login
  name               String   @unique // nome de exibição
  email              String?  @unique
  password           String
  role               String   @default("GARCOM") // ADMIN | GERENTE | GARCOM | COZINHA
  needsPasswordChange Boolean @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             Order[]

  @@map("user")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // ex: CONTA_FECHADA, STATUS_ALTERADO, SENHA_RESETADA
  actor     String   // username de quem fez a ação
  details   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}

model Table {
  id         String   @id @default(uuid())
  identifier String   @unique @map("number") // número ou nome (ex: 5, A3, Varanda)
  capacity   Int
  status    String   @default("FREE") // FREE | OCCUPIED | RESERVED | CLOSED
  clientName String?
  openedAt  DateTime? // quando a mesa foi aberta (sessão atual)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  closedAccounts ClosedAccount[]

  @@map("table")
}

model Product {
  id                  String      @id @default(uuid())
  name                String
  description         String?
  price               Int         @default(0) // preço fixo em centavos (acompanhamentos/bebidas)
  pricePerKg          Int?        @map("pricePerGram") // centavos por kg (carnes vendidas por peso)
  minGrams            Int?        // pedido mínimo em gramas (carnes)
  category            String      // CARNE | ACOMPANHAMENTO | CALDO | BEBIDA
  isMeat              Boolean     @default(false) // indica se vendido por peso
  available           Boolean     @default(true)
  quantidadeTotal     Int         @default(0)
  quantidadeDisponivel Int       @default(0)
  quantidadeMinima    Int         @default(10)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  orderItems          OrderItem[]
  estoqueMovimentacao EstoqueMovimentacao[]

  @@map("product")
}

model Order {
  id          String      @id @default(uuid())
  tableId     String
  userId      String
  status      String      @default("PENDING") // PENDING | PREPARING | READY | DELIVERED | CANCELLED | CLOSED
  totalAmount Int         @default(0) // em centavos
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  closedAccountId String? // conta em que o pedido foi pago
  table       Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  closedAccount ClosedAccount? @relation(fields: [closedAccountId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  estoqueMovimentacao EstoqueMovimentacao[]

  @@index([tableId])
  @@index([userId])
  @@index([closedAccountId])
  @@map("order")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int     // gramas (carne) ou unidades
  unitPrice Int     // snapshot do preço: centavos por kg (carne) ou por unidade
  weighed   Boolean @default(false) // true = carne vendida por peso
  notes     String?
  createdAt DateTime @default(now())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model EstoqueMovimentacao {
  id                  String   @id @default(uuid())
  productId           String
  quantidadeAnterior  Int
  quantidadeAtual     Int
  tipoMovimentacao    String   // VENDA | REPOSICAO | AJUSTE
  pedidoId            String?
  nota                String?
  createdAt           DateTime @default(now())
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order               Order?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([pedidoId])
  @@map("estoque_movimentacao")
}

// Conta fechada (registro permanente de cada fechamento de mesa)
model ClosedAccount {
  id              String   @id @default(uuid())
  tableId         String
  tableIdentifier String   // snapshot do número/nome da mesa
  clientName      String?
  openedAt        DateTime
  closedAt        DateTime @default(now())
  closedBy        String   // username de quem fechou
  subtotal        Int      // centavos, sem taxa
  serviceFee      Int      // centavos (10%)
  total           Int      // centavos
  table           Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders          Order[]
  payments        AccountPayment[]

  @@index([closedAt])
  @@index([tableId])
  @@map("closed_account")
}

// Forma de pagamento de uma conta fechada (uma conta pode ser dividida em vários pagamentos)
model AccountPayment {
  id              String        @id @default(uuid())
  closedAccountId String
  method          String        // DINHEIRO | PIX | DEBITO | CREDITO
  amount          Int           // centavos
  installments    Int           @default(1) // parcelas (só crédito)
  createdAt       DateTime      @default(now())
  closedAccount   ClosedAccount @relation(fields: [closedAccountId], references: [id], onDelete: Cascade)

  @@index([closedAccountId])
  @@map("account_payment")
}
